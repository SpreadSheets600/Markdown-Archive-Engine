---
/**
 * Rich previews for files that sit beside a document. The registry
 * below decides how each extension is presented - add an entry to
 * teach the site a new file format.
 */
import {
  FileCode,
  FileCsv,
  FilePdf,
  FileText,
  FileXls,
  FileZip,
  FilmStrip,
  Image as ImageIcon,
  MusicNotes,
  BracketsCurly,
} from "@phosphor-icons/react";

export interface Asset {
  /** Path relative to the repository root. */
  path: string;
  name: string;
  ext: string;
  bytes: number;
}

export interface Props {
  assets: Asset[];
  /** Directory of the current document, relative to root ("." for home). */
  dir: string;
}

const { assets, dir } = Astro.props;

const siblings = assets.filter(
  (a) => (a.path.includes("/") ? a.path.replace(/[^/]+$/, "") : ".") === dir && !/readme\.md/i.test(a.name),
);

type Presentation = {
  icon: any;
  tone: string;
  preview: "image" | "none";
};

/** Extension → presentation. Unknown formats fall back to a generic card. */
const REGISTRY: Record<string, Presentation> = {
  png: { icon: ImageIcon, tone: "text-muted-foreground", preview: "image" },
  jpg: { icon: ImageIcon, tone: "text-muted-foreground", preview: "image" },
  jpeg: { icon: ImageIcon, tone: "text-muted-foreground", preview: "image" },
  gif: { icon: ImageIcon, tone: "text-muted-foreground", preview: "image" },
  webp: { icon: ImageIcon, tone: "text-muted-foreground", preview: "image" },
  svg: { icon: ImageIcon, tone: "text-muted-foreground", preview: "image" },
  pdf: { icon: FilePdf, tone: "text-muted-foreground", preview: "none" },
  csv: { icon: FileCsv, tone: "text-muted-foreground", preview: "none" },
  xlsx: { icon: FileXls, tone: "text-muted-foreground", preview: "none" },
  json: { icon: BracketsCurly, tone: "text-muted-foreground", preview: "none" },
  c: { icon: FileCode, tone: "text-muted-foreground", preview: "none" },
  h: { icon: FileCode, tone: "text-muted-foreground", preview: "none" },
  cpp: { icon: FileCode, tone: "text-muted-foreground", preview: "none" },
  sh: { icon: FileCode, tone: "text-muted-foreground", preview: "none" },
  py: { icon: FileCode, tone: "text-muted-foreground", preview: "none" },
  zip: { icon: FileZip, tone: "text-muted-foreground", preview: "none" },
  tar: { icon: FileZip, tone: "text-muted-foreground", preview: "none" },
  gz: { icon: FileZip, tone: "text-muted-foreground", preview: "none" },
  txt: { icon: FileText, tone: "text-muted-foreground", preview: "none" },
  mp4: { icon: FilmStrip, tone: "text-muted-foreground", preview: "none" },
  mkv: { icon: FilmStrip, tone: "text-muted-foreground", preview: "none" },
  mp3: { icon: MusicNotes, tone: "text-muted-foreground", preview: "none" },
};

const GENERIC: Presentation = {
  icon: FileText,
  tone: "text-muted-foreground",
  preview: "none",
};

const formatBytes = (n) =>
  n < 1024
    ? `${n} B`
    : n < 1024 ** 2
      ? `${(n / 1024).toFixed(1)} KB`
      : `${(n / 1024 ** 2).toFixed(1)} MB`;

const href = (p) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}/${p}`;
};
---

{
  siblings.length > 0 && (
    <section class="mt-16 border-t border-border pt-8">
      <h2 class="mb-1 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
        Files in this folder
      </h2>
      <p class="mb-5 text-sm text-muted-foreground">
        Attachments that ship next to this document.
      </p>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {siblings.map((asset) => {
          const pres = REGISTRY[asset.ext.toLowerCase()] ?? GENERIC;
          const Icon = pres.icon;
          return (
            <li>
              <a
                href={href(asset.path)}
                class="group flex h-full flex-col overflow-hidden rounded-xl border border-border bg-card transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"
              >
                {pres.preview === "image" ? (
                  <span class="block aspect-video overflow-hidden border-b border-border bg-muted">
                    <img
                      src={href(asset.path)}
                      alt=""
                      loading="lazy"
                      class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
                    />
                  </span>
                ) : (
                  <span class="flex aspect-video items-center justify-center border-b border-border bg-secondary/50">
                    <Icon
                      class={`size-9 ${pres.tone} opacity-80 transition-transform duration-300 group-hover:scale-110`}
                    />
                  </span>
                )}
                <span class="min-w-0 px-3 py-2.5">
                  <span class="block truncate font-mono text-xs font-medium group-hover:text-primary">
                    {asset.name}
                  </span>
                  <span class="mt-0.5 block font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                    {asset.ext || "file"} · {formatBytes(asset.bytes)}
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
