---
/**
 * shadcn-style explorer tree: collapsible folders (chevron rotates),
 * lucide icons, active-item highlight. Folders on the path to the
 * current document start expanded. Rendered recursively.
 */
import { routeForDoc } from "@/lib/routes";
import { isReadme, sortTree, type SortedNode, type TreeNode } from "@/lib/tree";

export interface Props {
  tree: TreeNode;
  currentId?: string;
}

const { tree, currentId } = Astro.props;

const icon = (paths: string, cls: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" class="${cls}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">${paths}</svg>`;
const I = {
  chevron: icon('<path d="m9 18 6-6-6-6"/>', "size-3.5 shrink-0 text-muted-foreground transition-transform group-open:rotate-90 group-hover:text-foreground"),
  folder: icon('<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>', "size-4 shrink-0 text-muted-foreground"),
  folderOpen: icon('<path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"/>', "size-4 shrink-0 text-muted-foreground"),
  fileText: icon('<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>', "size-4 shrink-0"),
  fileCode: icon('<path d="M10 12.5 8 15l2 2.5"/><path d="m14 12.5 2 2.5-2 2.5"/><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>', "size-4 shrink-0"),
};

const activeParts: string[] = currentId ? currentId.split("/").slice(0, -1) : [];
const joinBase = (p: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}/${p}`;
};
const esc = (s: string) =>
  s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll('"', "&quot;");

function leafRow(href: string, iconName: keyof typeof I, label: string, active: boolean, depth: number): string {
  const pad = `padding-left:${depth * 1 + 0.5}rem`;
  const url =
    href.startsWith("/") && !href.startsWith(import.meta.env.BASE_URL)
      ? `${import.meta.env.BASE_URL}${href}`
      : href;
  const state = active
    ? "bg-accent font-medium text-accent-foreground"
    : "text-muted-foreground hover:bg-accent hover:text-foreground";
  return `<a href="${esc(url)}"${active ? ' aria-current="page"' : ""} class="flex items-center gap-2 rounded-md py-1.5 pe-2 transition-colors ${state}" style="${pad}">${I[iconName]}<span class="truncate font-mono text-[13px]">${esc(label)}</span></a>`;
}

function renderNode(node: SortedNode, name: string | null, depth: number, onPath: boolean): string {
  let out = "";
  const childDepth = name === null ? depth : depth + 1;

  if (name !== null) {
    const isOpen = onPath;
    out += `<details${isOpen ? " open" : ""}><summary class="group flex cursor-pointer list-none items-center gap-2 rounded-md py-1.5 pe-2 font-medium text-foreground/80 transition-colors hover:bg-accent hover:text-foreground [&::-webkit-details-marker]:hidden" style="padding-left:${depth * 1 + 0.5}rem">${I.chevron}${I.folder}<span class="truncate">${esc(name)}</span></summary>`;
    out += `<div class="mt-0.5 flex flex-col gap-0.5">`;
  }

  // Only the matching top-level folder starts expanded
  let matchedChild: SortedNode | null = null;
  for (const child of node.folders) {
    if (onPath && activeParts[depth] === child.name && !matchedChild)
      matchedChild = child;
  }
  for (const child of node.folders) {
    out += renderNode(child, child.name, childDepth, onPath && child === matchedChild);
  }
  for (const d of node.docs) {
    out += leafRow(
      routeForDoc(d.doc.id),
      "fileText",
      isReadme(d.name) ? "README.md" : d.name,
      d.doc.id === currentId,
      childDepth,
    );
  }
  for (const a of node.assets) {
    out += leafRow(joinBase(a.path), "fileCode", a.name, false, childDepth);
  }

  if (name !== null) out += `</div></details>`;
  return out;
}
---

<div class="text-sm">
  <Fragment set:html={renderNode(sortTree(tree), null, 0, true)} />
</div>
