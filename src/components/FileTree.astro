---
/**
 * shadcn-style explorer tree: collapsible folders (caret rotates),
 * Phosphor icons, active-item highlight. Folders on the path to the
 * current document start expanded. Rendered recursively.
 */
import { routeForDoc } from "@/lib/routes";
import { isReadme, sortTree, type SortedNode, type TreeNode } from "@/lib/tree";

export interface Props {
  tree: TreeNode;
  currentId?: string;
}

const { tree, currentId } = Astro.props;

const icon = (paths: string, cls: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" class="${cls}" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">${paths}</svg>`;
const I = {
  caret: icon('<path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"/>', "size-3 shrink-0 text-muted-foreground transition-transform group-open:rotate-90 group-hover:text-foreground"),
  folder: icon('<path d="M216,72H131.31L104,44.69A15.86,15.86,0,0,0,92.69,40H40A16,16,0,0,0,24,56V200.62A15.4,15.4,0,0,0,39.38,216H216.89A15.13,15.13,0,0,0,232,200.89V88A16,16,0,0,0,216,72ZM40,56H92.69l16,16H40ZM216,200H40V88H216Z"/>', "size-4 shrink-0 text-muted-foreground"),
  folderOpen: icon('<path d="M245,110.64A16,16,0,0,0,232,104H216V88a16,16,0,0,0-16-16H130.67L102.94,51.2a16.14,16.14,0,0,0-9.6-3.2H40A16,16,0,0,0,24,64V208h0a8,8,0,0,0,8,8H211.1a8,8,0,0,0,7.59-5.47l28.49-85.47A16.05,16.05,0,0,0,245,110.64ZM93.34,64,123.2,86.4A8,8,0,0,0,128,88h72v16H69.77a16,16,0,0,0-15.18,10.94L40,158.7V64Zm112,136H43.1l26.67-80H232Z"/>', "size-4 shrink-0 text-muted-foreground"),
  fileText: icon('<path d="M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,136Zm0,32a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,168Z"/>', "size-4 shrink-0"),
  fileCode: icon('<path d="M181.66,146.34a8,8,0,0,1,0,11.32l-24,24a8,8,0,0,1-11.32-11.32L164.69,152l-18.35-18.34a8,8,0,0,1,11.32-11.32Zm-72-24a8,8,0,0,0-11.32,0l-24,24a8,8,0,0,0,0,11.32l24,24a8,8,0,0,0,11.32-11.32L91.31,152l18.35-18.34A8,8,0,0,0,109.66,122.34ZM216,88V216a16,16,0,0,1-16,16H56a16,16,0,0,1-16-16V40A16,16,0,0,1,56,24h96a8,8,0,0,1,5.66,2.34l56,56A8,8,0,0,1,216,88Zm-56-8h28.69L160,51.31Zm40,136V96H152a8,8,0,0,1-8-8V40H56V216H200Z"/>', "size-4 shrink-0"),
};

const activeParts: string[] = currentId ? currentId.split("/").slice(0, -1) : [];
const joinBase = (p: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}/${p}`;
};
const esc = (s: string) =>
  s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll('"', "&quot;");

function leafRow(href: string, iconName: keyof typeof I, label: string, active: boolean, depth: number): string {
  const pad = `padding-left:${depth * 1 + 0.5}rem`;
  const url =
    href.startsWith("/") && !href.startsWith(import.meta.env.BASE_URL)
      ? `${import.meta.env.BASE_URL}${href}`
      : href;
  const state = active
    ? "bg-accent font-medium text-accent-foreground"
    : "text-muted-foreground hover:bg-accent hover:text-foreground";
  return `<a href="${esc(url)}"${active ? ' aria-current="page"' : ""} class="flex items-center gap-2 rounded-md py-1.5 pe-2 transition-colors ${state}" style="${pad}">${I[iconName]}<span class="truncate font-mono text-[13px]">${esc(label)}</span></a>`;
}

function renderNode(node: SortedNode, name: string | null, depth: number, onPath: boolean): string {
  let out = "";
  const childDepth = name === null ? depth : depth + 1;

  if (name !== null) {
    const isOpen = onPath;
    out += `<details${isOpen ? " open" : ""}><summary class="group flex cursor-pointer list-none items-center gap-2 rounded-md py-1.5 pe-2 font-medium text-foreground/80 transition-colors hover:bg-accent hover:text-foreground [&::-webkit-details-marker]:hidden" style="padding-left:${depth * 1 + 0.5}rem">${I.caret}${I.folder}<span class="truncate">${esc(name)}</span></summary>`;
    out += `<div class="mt-0.5 flex flex-col gap-0.5">`;
  }

  // Only the matching top-level folder starts expanded
  let matchedChild: SortedNode | null = null;
  for (const child of node.folders) {
    if (onPath && activeParts[depth] === child.name && !matchedChild)
      matchedChild = child;
  }
  for (const child of node.folders) {
    out += renderNode(child, child.name, childDepth, onPath && child === matchedChild);
  }
  for (const d of node.docs) {
    out += leafRow(
      routeForDoc(d.doc.id),
      "fileText",
      isReadme(d.name) ? "README.md" : d.name,
      d.doc.id === currentId,
      childDepth,
    );
  }
  for (const a of node.assets) {
    out += leafRow(joinBase(a.path), "fileCode", a.name, false, childDepth);
  }

  if (name !== null) out += `</div></details>`;
  return out;
}
---

<div class="text-sm">
  <Fragment set:html={renderNode(sortTree(tree), null, 0, true)} />
</div>
